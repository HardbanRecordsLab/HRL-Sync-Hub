# ─────────────────────────────────────────────────────────────────────────────
# backend/.env — for running the API WITHOUT Docker (npm run dev).
# The Docker stack uses the ROOT .env instead (see .env.example at repo root).
# Copy to backend/.env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hrlsync:dev@localhost:5432/hrlsync
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Auth (pure JWT, no external provider) ───────────────────────────────────
JWT_SECRET=                       # openssl rand -base64 48
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=HRL Admin

# ─── Library object storage ────────────────────────────────────────────────
STORAGE_DRIVER=fs                 # 'fs' (local dir) or 's3' (MinIO/S3)
STORAGE_FS_DIR=./uploads
# 's3' driver (MinIO / AWS S3 / R2 / B2):
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hrl-audio
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
MAX_UPLOAD_MB=300


# ─── AI (optional — track auto-tagging via OpenRouter) ─────────────────────
OPENROUTER_API_KEY=
AI_MODELS=

# ─── Error tracking (optional) ─────────────────────────────────────────────
SENTRY_DSN=

# ─── Email (optional — pitch notifications) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HRL Sync <sync@hardbanrecordslab.online>"

LOG_LEVEL=info
