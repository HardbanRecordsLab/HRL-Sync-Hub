# ─────────────────────────────────────────────────────────────────────────────
# HRL Sync API — backend configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# Public URL of this API (used to build the embed player links)
API_URL=https://sync-api.hardbanrecordslab.online

# Frontend origin(s) allowed by CORS + used for OAuth redirects.
# Comma-separated. localhost:3000/5173/8080 are always allowed.
FRONTEND_URL=https://app.hrl-sync-hub.hardbanrecordslab.online
ALLOWED_ORIGINS=https://app.hrl-sync-hub.hardbanrecordslab.online

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hrlsync:CHANGE_ME@localhost:5432/hrlsync
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Auth (pure JWT, no external provider) ───────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin bootstrap — used only by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=HRL Admin

# ─── Google Drive (audio storage) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sync-api.hardbanrecordslab.online/api/auth/google/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Optional service account JSON (single line) for public/embed playback
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── AI (optional — track auto-tagging) ─────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Email (optional — pitch notifications) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HRL Sync <sync@hardbanrecordslab.online>"

# ─── Misc ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
EMBED_ALLOWED_DOMAINS=hardbanrecordslab.online
