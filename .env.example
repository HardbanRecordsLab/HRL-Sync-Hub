# ─────────────────────────────────────────────────────────────────────────────
# Root .env — used by docker-compose (compose interpolation + the api container).
# Copy to .env and fill in. NEVER commit .env.
# For running the API WITHOUT Docker, use backend/.env instead.
# ─────────────────────────────────────────────────────────────────────────────

# Host port the API is published on
API_PORT=3001

# Public URLs
API_URL=https://hrl-sync.hardbanrecordslab.online
FRONTEND_URL=https://hrl-sync.hub.hardbanrecordslab.online
ALLOWED_ORIGINS=https://hrl-sync.hub.hardbanrecordslab.online

# Postgres (compose runs its own container; change only if you want a custom pw)
POSTGRES_PASSWORD=change_me_pg

# Shared-Postgres deploy only (see docker-compose.yml header): also set DATABASE_URL to
# your shared server, and set this to that same server's `cmlp` database (same host/user/
# password, different dbname) — used for INSERTs that create a new track (upload, Drive
# import), since a postgres_fdw foreign table can't carry over cmlp.tracks.id's serial
# default. Leave empty for the bundled/local-Postgres deploy (there is no shared catalog).
CMLP_DATABASE_URL=

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=                       # openssl rand -base64 48
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=HRL Admin

# ─── Object storage (MinIO container) ───────────────────────────────────────
S3_BUCKET=hrl-audio
S3_ACCESS_KEY=hrl-minio           # becomes the MinIO root user
S3_SECRET_KEY=                    # >= 8 chars — becomes the MinIO root password
S3_REGION=us-east-1
MAX_UPLOAD_MB=300

# ─── AI (optional — track auto-tagging via OpenRouter) ─────────────────────
OPENROUTER_API_KEY=
# Ordered fallback list (free models first, one cheap paid model last).
# Leave blank for the built-in default. Update anytime, then `docker compose up -d`.
AI_MODELS=

# ─── Error tracking (optional) ─────────────────────────────────────────────
SENTRY_DSN=

# ─── Email (optional — pitch notifications) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HRL Sync <sync@hardbanrecordslab.online>"

LOG_LEVEL=info
